# /etc/barnyard-reporter/env  (root-only: the installer makes it mode 0600). One KEY=value per line, no quotes needed
# unless a value has spaces. See reporter/README.md.

# Which server this is: app02, cld01 or vtt, or (in your own Monitoring page) the name it shows for this server. The key below only works for this one.
BR_SERVER=
# The key from the hub's Monitoring page (shown once when you make it).
BR_KEY=

# Where to report. Leave as it is.
BR_URL=https://api.barnyard.site/mon/report

# Mount points to report, separated by spaces.
BR_DISKS="/"

# systemd units to report as running or not, separated by spaces (names only, for example: cloudflared docker).
BR_SERVICES=""

# The OTHER servers to try to reach from here, so the servers report on each other. id=address, separated by spaces.
# An address is https://host/path (answering with anything below 500 counts as reachable) or tcp:host:port.
# Do not list this server itself. Examples:
#   BR_PEERS="vtt=https://vtt.barnyard.site/ cld01=tcp:203.0.113.10:22"
BR_PEERS=""

# ---- the daily inventory (barnyard-inventory) ----------------------------------------------------------------
# Where to send it. Leave as it is.
BR_INVENTORY_URL=https://api.barnyard.site/mon/inventory
# 0 switches the daily inventory off on this server.
BR_INVENTORY=1
# 1 lets the inventory ask Docker which images are running (it then runs with the "docker" group, which can control
# Docker: only switch it on if you want the container images listed). Read by install.sh.
BR_INVENTORY_DOCKER=0
